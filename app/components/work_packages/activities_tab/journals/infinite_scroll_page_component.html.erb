<%=
  component_wrapper(data: { page_number: page_number(current_page) }) do
    if next_page
      helpers.turbo_frame_tag(
        page_number(next_page),
        src: page_url(next_page),
        loading: :lazy
      ) do
        flex_layout(class: "work-packages-activities-tab-journals-item-component", bg: :default) do |skeleton|
          skeleton.with_row(mb: 2) do
            render(Primer::Alpha::SkeletonBox.new(width: "25%", height: "40px"))
          end

          skeleton.with_row(mb: 3) do
            render(Primer::Alpha::SkeletonBox.new(width: "100%", height: "150px"))
          end
        end
      end
    end
  end
%>
